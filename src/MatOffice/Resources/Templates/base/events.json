  "tables": [
    {
      "name": "Venues", "description": "Where events take place",
      "fields": [
        ["VenueID", "autonumber", { "pk": true }],
        ["Venue", "text", { "size": 80, "required": true, "unique": true }],
        ["City", "text", { "size": 50 }],
        ["Address", "text", { "size": 120 }],
        ["Capacity", "number", { "rule": ">0", "ruleText": "The capacity must be greater than 0." }]
      ],
      "rows": [
        [1, "Conference Center Harbour", "Hamburg", "Am Kai 1", 400],
        [2, "Old Town Hall", "Cologne", "Rathausplatz 3", 120],
        [3, "Riverside Loft", "Munich", "Isarweg 12", 80],
        [4, "University Hall A", "Berlin", "Unter den Linden 6", 250]
      ]
    },
    {
      "name": "Events", "description": "What takes place",
      "fields": [
        ["EventID", "autonumber", { "pk": true }],
        ["Event", "text", { "size": 100, "required": true }],
        ["VenueID", "number", { "lookup": "Venues.VenueID.Venue", "caption": "Venue" }],
        ["EventDate", "datetime", { "format": "General Date", "required": true }],
        ["Fee", "currency", { "default": "0", "rule": ">=0" }],
        ["MaxAttendees", "number", { "caption": "Max. attendees" }],
        ["Description", "memo"]
      ],
      "rows": [
        [1, "Data Day 2026", 1, "@-30T09:00:00", 149, 300, "A day of talks about data and databases."],
        [2, "Access for Beginners", 2, "@12T13:00:00", 59, 40, "Tables, queries, forms and reports in one afternoon."],
        [3, "Summer Party", 3, "@25T18:00:00", 0, 80, "Food, music and good company."],
        [4, "Reporting Workshop", 4, "@40T10:00:00", 89, 30, "Better reports with grouping and totals."],
        [5, "Year-end Meetup", 1, "@70T17:30:00", 25, 150, "Looking back at the year."]
      ]
    },
    {
      "name": "Attendees", "description": "People who take part",
      "fields": [
        ["AttendeeID", "autonumber", { "pk": true }],
        ["FirstName", "text", { "size": 50 }],
        ["LastName", "text", { "size": 50, "required": true, "indexed": true }],
        ["Company", "text", { "size": 80 }],
        ["Email", "hyperlink"],
        ["Phone", "text", { "size": 30 }]
      ],
      "rows": [
        [1, "Anna", "Schmidt", "Nordlicht Software", "mailto:anna@example.com", "+49 40 5552001"],
        [2, "Jonas", "Becker", "Nordlicht Software", "mailto:jonas@example.com", null],
        [3, "Maria", "Huber", "Bergmann Handel", "mailto:maria@example.com", "+49 89 5552003"],
