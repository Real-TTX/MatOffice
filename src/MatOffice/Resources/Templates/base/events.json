        [8, "Paul", "Schneider", "Rheinwerk", "mailto:paul@example.com", "+49 221 5552008"],
        [9, "Emma", "Hoffmann", null, "mailto:emma@example.com", null],
        [10, "Ben", "Koch", "Universität", "mailto:ben@example.com", null]
      ]
    },
    {
      "name": "Registrations", "description": "Who comes to what",
      "fields": [
        ["RegistrationID", "autonumber", { "pk": true }],
        ["EventID", "number", { "lookup": "Events.EventID.Event", "required": true, "caption": "Event" }],
        ["AttendeeID", "number", { "lookup": "Attendees.AttendeeID.LastName", "required": true, "caption": "Attendee" }],
        ["RegisteredOn", "datetime", { "default": "Date()", "format": "Short Date" }],
        ["Ticket", "text", { "size": 20, "values": ["Standard", "VIP", "Student"], "default": "\"Standard\"" }],
        ["Paid", "yesno"]
      ],
      "rows": [
        [1, 1, 1, "@-80", "VIP", true], [2, 1, 2, "@-78", "Standard", true], [3, 1, 3, "@-70", "Standard", true], [4, 1, 8, "@-65", "Standard", true], [5, 1, 10, "@-60", "Student", true],
        [6, 2, 4, "@-10", "Standard", true], [7, 2, 7, "@-8", "Standard", false], [8, 2, 9, "@-5", "Student", false],
        [9, 3, 1, "@-6", "Standard", true], [10, 3, 2, "@-6", "Standard", true], [11, 3, 5, "@-4", "VIP", false], [12, 3, 6, "@-3", "Standard", true],
        [13, 4, 3, "@-2", "Standard", false], [14, 4, 8, "@-1", "Standard", true],
        [15, 5, 1, "@-1", "Standard", false]
      ]
    }
  ],
  "relationships": [
    ["Venues.VenueID", "Events.VenueID", "integrity"],
    ["Events.EventID", "Registrations.EventID", "cascade"],
    ["Attendees.AttendeeID", "Registrations.AttendeeID", "cascade"]
  ],
  "queries": [
    { "name": "Registrations per Event", "sql": "SELECT {Events}.{Event}, {Events}.{EventDate}, Count({Registrations}.{RegistrationID}) AS {Registered}, {Events}.{MaxAttendees}, [{MaxAttendees}]-Count({Registrations}.{RegistrationID}) AS {FreeSeats}\nFROM {Events} LEFT JOIN {Registrations} ON {Events}.{EventID}={Registrations}.{EventID}\nGROUP BY {Events}.{Event}, {Events}.{EventDate}, {Events}.{MaxAttendees}\nORDER BY {Events}.{EventDate};" },
    { "name": "Unpaid Registrations", "sql": "SELECT {Attendees}.{LastName}, {Attendees}.{FirstName}, {Events}.{Event}, {Events}.{Fee}, {Registrations}.{RegisteredOn}\nFROM ({Attendees} INNER JOIN {Registrations} ON {Attendees}.{AttendeeID}={Registrations}.{AttendeeID}) INNER JOIN {Events} ON {Events}.{EventID}={Registrations}.{EventID}\nWHERE (({Registrations}.{Paid}=False) AND ({Events}.{Fee}>0))\nORDER BY {Attendees}.{LastName};" },
    { "name": "Upcoming Events", "sql": "SELECT {Events}.{Event}, {Events}.{EventDate}, {Venues}.{Venue}, {Venues}.{City}, {Events}.{Fee}\nFROM {Venues} INNER JOIN {Events} ON {Venues}.{VenueID}={Events}.{VenueID}\nWHERE ({Events}.{EventDate}>=Date())\nORDER BY {Events}.{EventDate};" },
    { "name": "Attendee List", "sql": "SELECT {Events}.{Event}, {Attendees}.{LastName}, {Attendees}.{FirstName}, {Attendees}.{Company}, {Registrations}.{Ticket}, {Registrations}.{Paid}, {Events}.{Fee}\nFROM ({Attendees} INNER JOIN {Registrations} ON {Attendees}.{AttendeeID}={Registrations}.{AttendeeID}) INNER JOIN {Events} ON {Events}.{EventID}={Registrations}.{EventID}\nORDER BY {Events}.{Event}, {Attendees}.{LastName};" }
  ],
  "forms": [
    { "name": "Events", "source": "Events", "subform": { "source": "Registrations", "link": "EventID" } },
    { "name": "Attendees", "source": "Attendees", "subform": { "source": "Registrations", "link": "AttendeeID" } },
    { "name": "Venues", "source": "Venues", "kind": "continuous" }
  ],
  "reports": [
    { "name": "Attendees by Event", "source": "Attendee List", "fields": ["Event", "LastName", "FirstName", "Company", "Ticket", "Paid", "Fee"], "group": ["Event"], "sort": ["LastName"], "sums": ["Fee"], "landscape": true }
  ],
  "layout": { "Venues": [40, 40], "Events": [290, 40], "Registrations": [540, 80], "Attendees": [790, 40] }
}
