@page "/Documents/Edit"
@model MatOffice.Pages.Documents.EditModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["PageSub"] = L["Kinds." + Model.Kind].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Documents.Title"].Value, "/home"), (Model.Name, null) };
    ViewData["Width"] = "narrow";
}

@section TopActions {
    <a class="mat-btn mat-btn--secondary mat-btn--icon" href="@Model.EditorUrl" aria-label="@L["Documents.Open"]" data-tip="@L["Documents.Open"]">@Ui.Icon("external")</a>
}

<partial name="_DocumentTabs" model='(Model.Id, "general", true)' />

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <mo-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="200" autofocus msg-required="@L["Common.NameRequired"]" />
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["Documents.Details"]</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>@L["Documents.Col.Kind"]</dt><dd><span class="mo-kind mo-kind--@Model.Slug">@Ui.Icon("kind-" + Model.Slug)<span>@L["Kinds." + Model.Kind]</span></span></dd>
                <dt>@L["Documents.Created"]</dt><dd>@Dates.Stamp(Model.Created, Model.Zone)</dd>
                <dt>@L["Documents.Col.Changed"]</dt><dd>@Dates.Stamp(Model.Changed, Model.Zone)</dd>
                <dt>@L["Documents.Size"]</dt><dd class="mat-mono">@Ui.Bytes(Model.Size)</dd>
            </dl>
        </div>
    </div>
    <mo-buttons save="@L["Common.Save"]" back="/home" delete-handler="Delete" delete-label="@L["Documents.Trash"]"
                delete-confirm="@L["Documents.TrashConfirm", Model.Name]" />
</form>
