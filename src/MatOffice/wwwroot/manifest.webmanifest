{
  "id": "/",
  "name": "MatOffice",
  "short_name": "MatOffice",
  "description": "Office in the browser: documents, spreadsheets, presentations and databases. Office im Browser: Texte, Tabellen, Präsentationen und Datenbanken.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f5f4f1",
  "theme_color": "#205a8e",
  "categories": [
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Docs / Texte",
      "short_name": "Docs",
      "url": "/docs",
      "icons": [
        {
          "src": "/img/logo/docs-favicon.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Sheets / Tabellen",
      "short_name": "Sheets",
      "url": "/sheets",
      "icons": [
        {
          "src": "/img/logo/sheets-favicon.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Slides / Präsentationen",
      "short_name": "Slides",
      "url": "/slides",
      "icons": [
        {
          "src": "/img/logo/slides-favicon.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Base / Datenbank",
      "short_name": "Base",
      "url": "/base",
      "icons": [
        {
          "src": "/img/logo/base-favicon.svg",
          "sizes": "any"
        }
      ]
    }
  ]
}
