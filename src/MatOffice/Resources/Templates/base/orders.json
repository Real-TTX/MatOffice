  "relationships": [
    ["Categories.CategoryID", "Products.CategoryID", "integrity"],
    ["Customers.CustomerID", "Orders.CustomerID", "integrity"],
    ["Orders.OrderID", "Order Details.OrderID", "cascade"],
    ["Products.ProductID", "Order Details.ProductID", "integrity"]
  ],
  "queries": [
    { "name": "Order Details Extended", "description": "The lines of all orders with their amount", "sql": "SELECT {Order Details}.{OrderID}, {Products}.{ProductName}, {Order Details}.{Quantity}, {Order Details}.{UnitPrice}, {Order Details}.{Discount}, CCur({Order Details}.{UnitPrice}*[{Quantity}]*(1-[{Discount}])) AS {LineTotal}\nFROM {Products} INNER JOIN {Order Details} ON {Products}.{ProductID}={Order Details}.{ProductID}\nORDER BY {Order Details}.{OrderID};" },
    { "name": "Sales by Category", "sql": "SELECT {Categories}.{Category}, Sum(CCur({Order Details}.{UnitPrice}*[{Quantity}]*(1-[{Discount}]))) AS {Sales}\nFROM ({Categories} INNER JOIN {Products} ON {Categories}.{CategoryID}={Products}.{CategoryID}) INNER JOIN {Order Details} ON {Products}.{ProductID}={Order Details}.{ProductID}\nGROUP BY {Categories}.{Category}\nORDER BY Sum(CCur({Order Details}.{UnitPrice}*[{Quantity}]*(1-[{Discount}]))) DESC;" },
    { "name": "Order Totals", "sql": "SELECT {Orders}.{OrderID}, {Customers}.{Company}, {Orders}.{OrderDate}, {Orders}.{Status}, Sum(CCur({Order Details}.{UnitPrice}*[{Quantity}]*(1-[{Discount}]))) AS {Total}\nFROM ({Customers} INNER JOIN {Orders} ON {Customers}.{CustomerID}={Orders}.{CustomerID}) INNER JOIN {Order Details} ON {Orders}.{OrderID}={Order Details}.{OrderID}\nGROUP BY {Orders}.{OrderID}, {Customers}.{Company}, {Orders}.{OrderDate}, {Orders}.{Status}\nORDER BY {Orders}.{OrderDate} DESC;" },
    { "name": "Products to Reorder", "sql": "SELECT {Products}.{ProductName}, {Products}.{UnitsInStock}, {Products}.{ReorderLevel}\nFROM {Products}\nWHERE (({Products}.{UnitsInStock}<=[{ReorderLevel}]) AND ({Products}.{Discontinued}=False))\nORDER BY {Products}.{UnitsInStock};" },
    { "name": "Orders in Period", "sql": "SELECT {Orders}.{OrderID}, {Customers}.{Company}, {Orders}.{OrderDate}, {Orders}.{Status}\nFROM {Customers} INNER JOIN {Orders} ON {Customers}.{CustomerID}={Orders}.{CustomerID}\nWHERE ({Orders}.{OrderDate} Between {Start date} And {End date})\nORDER BY {Orders}.{OrderDate};" },
    { "name": "Sales Details", "sql": "SELECT {Categories}.{Category}, {Products}.{ProductName}, {Orders}.{OrderDate}, {Order Details}.{Quantity}, CCur({Order Details}.{UnitPrice}*[{Quantity}]*(1-[{Discount}])) AS {LineTotal}\nFROM (({Categories} INNER JOIN {Products} ON {Categories}.{CategoryID}={Products}.{CategoryID}) INNER JOIN {Order Details} ON {Products}.{ProductID}={Order Details}.{ProductID}) INNER JOIN {Orders} ON {Orders}.{OrderID}={Order Details}.{OrderID}\nORDER BY {Categories}.{Category}, {Products}.{ProductName};" },
    { "name": "Product List", "sql": "SELECT {Categories}.{Category}, {Products}.{ProductName}, {Products}.{UnitPrice}, {Products}.{UnitsInStock}\nFROM {Categories} INNER JOIN {Products} ON {Categories}.{CategoryID}={Products}.{CategoryID}\nWHERE ({Products}.{Discontinued}=False)\nORDER BY {Categories}.{Category}, {Products}.{ProductName};" },
    { "name": "Raise Prices by 5 %", "description": "Raises the prices of all products that are still sold", "sql": "UPDATE {Products}\nSET {Products}.{UnitPrice} = CCur([{UnitPrice}]*1.05)\nWHERE ({Products}.{Discontinued}=False);" }
  ],
  "forms": [
    { "name": "Customers", "source": "Customers", "subform": { "source": "Orders", "link": "CustomerID" } },
    { "name": "Orders", "source": "Orders", "fields": ["OrderID", "CustomerID", "OrderDate", "ShippedDate", "Status"], "subform": { "source": "Order Details", "link": "OrderID" } },
    { "name": "Products", "source": "Products", "kind": "continuous", "fields": ["ProductName", "CategoryID", "UnitPrice", "UnitsInStock", "Discontinued"] }
  ],
  "reports": [
    { "name": "Sales by Category", "title": "Sales Report", "source": "Sales Details", "fields": ["Category", "ProductName", "OrderDate:datetime", "Quantity", "LineTotal:currency"], "group": ["Category"], "sort": ["ProductName"], "sums": ["Quantity", "LineTotal"] },
    { "name": "Product List", "source": "Product List", "fields": ["Category", "ProductName", "UnitPrice", "UnitsInStock"], "group": ["Category"], "sort": ["ProductName"], "sums": ["UnitsInStock"] },
    { "name": "Order Totals", "source": "Order Totals", "fields": ["Status", "OrderID", "Company", "OrderDate", "Total:currency"], "group": ["Status"], "sort": ["OrderDate"], "sums": ["Total"] }
  ],
  "layout": { "Customers": [30, 40], "Orders": [260, 40], "Order Details": [500, 60], "Products": [740, 40], "Categories": [960, 60] }
}
