  "relationships": [
    ["Companies.CompanyID", "Contacts.CompanyID", "integrity"],
    ["Contacts.ContactID", "Calls.ContactID", "cascade"]
  ],
  "queries": [
    { "name": "Active Customers", "sql": "SELECT {Contacts}.{FirstName}, {Contacts}.{LastName}, {Companies}.{Company}, {Contacts}.{Email}, {Contacts}.{Phone}\nFROM {Companies} INNER JOIN {Contacts} ON {Companies}.{CompanyID}={Contacts}.{CompanyID}\nWHERE (({Contacts}.{Category}=\"Customer\") AND ({Contacts}.{Active}=True))\nORDER BY {Contacts}.{LastName};" },
    { "name": "Contacts by City", "sql": "SELECT {Contacts}.{FirstName}, {Contacts}.{LastName}, {Contacts}.{City}, {Contacts}.{Phone}\nFROM {Contacts}\nWHERE ({Contacts}.{City}={Which city?})\nORDER BY {Contacts}.{LastName};" },
    { "name": "Calls to Follow Up", "sql": "SELECT {Contacts}.{LastName}, {Calls}.{CallDate}, {Calls}.{Subject}, {Calls}.{Outcome}, {Calls}.{FollowUp}\nFROM {Contacts} INNER JOIN {Calls} ON {Contacts}.{ContactID}={Calls}.{ContactID}\nWHERE ({Calls}.{FollowUp} Is Not Null)\nORDER BY {Calls}.{FollowUp};" },
    { "name": "Contacts per Company", "sql": "SELECT {Companies}.{Company}, Count({Contacts}.{ContactID}) AS {NumberOfContacts}\nFROM {Companies} LEFT JOIN {Contacts} ON {Companies}.{CompanyID}={Contacts}.{CompanyID}\nGROUP BY {Companies}.{Company}\nORDER BY {Companies}.{Company};" }
  ],
  "forms": [
    { "name": "Contacts", "source": "Contacts", "fields": ["FirstName", "LastName", "CompanyID", "JobTitle", "Category", "Email", "Phone", "Birthday", "Active"], "subform": { "source": "Calls", "link": "ContactID" } },
    { "name": "Companies", "source": "Companies", "subform": { "source": "Contacts", "link": "CompanyID" } },
    { "name": "Contact List", "source": "Contacts", "kind": "continuous", "fields": ["FirstName", "LastName", "Category", "Phone", "City", "Active"] }
  ],
  "reports": [
    { "name": "Contacts by Category", "source": "Contacts", "fields": ["Category", "LastName", "FirstName", "Phone", "City"], "group": ["Category"], "sort": ["LastName"] },
    { "name": "Phone List", "source": "Contacts", "fields": ["LastName", "FirstName", "Phone", "City"], "sort": ["LastName"] }
  ],
  "layout": { "Companies": [40, 40], "Contacts": [300, 40], "Calls": [560, 80] }
}
